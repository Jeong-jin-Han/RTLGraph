{
  "name": "rtlgraph",
  "displayName": "RTLGraph",
  "description": "High-level schematics of RTL projects, drawn from *.rtlgraph.json",
  "version": "0.1.0",
  "publisher": "JeongjinHan",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeong-jin-Han/RTLGraph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:rtlgraph.editor"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "rtlgraph.editor",
        "displayName": "RTLGraph Schematic",
        "selector": [
          {
            "filenamePattern": "*.rtlgraph.json"
          },
          {
            "filenamePattern": "*.rtlgraph-schematic.json"
          },
          {
            "filenamePattern": "*.rtlgraph-fsm.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "rtlgraph.copyAgentSpec",
        "title": "RTLGraph: Copy Agent Spec to Workspace"
      },
      {
        "command": "rtlgraph.export",
        "title": "RTLGraph: Export Schematic (SVG / PNG / PDF)"
      },
      {
        "command": "rtlgraph.fold",
        "title": "RTLGraph: Fold Components"
      },
      {
        "command": "rtlgraph.unfold",
        "title": "RTLGraph: Unfold Components"
      },
      {
        "command": "rtlgraph.openComponent",
        "title": "RTLGraph: Open Component Schematic"
      },
      {
        "command": "rtlgraph.openRoot",
        "title": "RTLGraph: Open Root File"
      },
      {
        "command": "rtlgraph.openFsm",
        "title": "RTLGraph: Open State Machine"
      },
      {
        "command": "rtlgraph.openSchematic",
        "title": "RTLGraph: Open the Component Schematic"
      },
      {
        "command": "rtlgraph.openCode",
        "title": "RTLGraph: Open the Code of the Selected Box"
      },
      {
        "command": "rtlgraph.fitView",
        "title": "RTLGraph: Fit View"
      },
      {
        "command": "rtlgraph.setPreset",
        "title": "RTLGraph: Set View Preset"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "rtlgraph.copyAgentSpec",
          "when": "explorerResourceIsFolder",
          "group": "rtlgraph"
        }
      ]
    },
    "configuration": {
      "title": "RTLGraph",
      "properties": {
        "rtlgraph.export.folder": {
          "type": "string",
          "default": ".out-${name}",
          "markdownDescription": "Folder next to the graph file that exports are written to. `${name}` is the graph file name without `.rtlgraph.json`. The default is hidden, like NodeGraph's `.<name>-imgs`; use `out-${name}` for a visible folder."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "e2e": "node test-e2e/run.mjs"
  },
  "dependencies": {
    "@rtlgraph/ir": "0.1.0",
    "@rtlgraph/layout": "0.1.0",
    "@rtlgraph/registry": "0.1.0",
    "@rtlgraph/render": "0.1.0",
    "@rtlgraph/sheet": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2"
  }
}
