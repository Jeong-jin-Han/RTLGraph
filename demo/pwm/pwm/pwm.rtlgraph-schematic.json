    "SET":      { "width": 1, "flow": "control", "driver": "@SET",    "sinks": ["control_path:SET", "u_rdy:SET"], "meaning": "1 cycle: take PERIOD and DUTY and start the wave", "origin": { "file": "seq/pwm_top.v", "line": 13 } },
    "STOP":     { "width": 1, "flow": "control", "driver": "@STOP",   "sinks": ["control_path:STOP"], "meaning": "1 cycle: stop the wave", "origin": { "file": "seq/pwm_top.v", "line": 14 } },
    "STATE_D":  { "width": 2, "flow": "control", "driver": "control_path:STATE_D", "sinks": ["STATE_FF:D"], "meaning": "the state the next cycle is in", "origin": { "file": "seq/pwm_top.v", "line": 20 } },
    "STATE_Q":  { "width": 2, "flow": "control", "driver": "STATE_FF:Q", "sinks": ["control_path:STATE"], "meaning": "0=IDLE, 1=LOAD, 2=RUN", "origin": { "file": "seq/pwm_top.v", "line": 19 } },
    "LOAD_EN":  { "width": 1, "flow": "control", "driver": "control_path:LOAD_EN", "sinks": ["PERIOD_FF:EN", "DUTY_FF:EN"], "meaning": "1=capture PERIOD and DUTY", "origin": { "file": "seq/pwm_top.v", "line": 21 } },
    "RUN_EN":   { "width": 1, "flow": "control", "driver": "control_path:RUN_EN", "sinks": ["u_pulse:RUN"], "meaning": "1=the pulse generator is running", "origin": { "file": "seq/pwm_top.v", "line": 22 } },
    "STOPPED":  { "width": 1, "flow": "control", "driver": "control_path:STOPPED", "sinks": ["u_rdy:STOPPED"], "meaning": "1=the core is not driving a wave", "origin": { "file": "seq/pwm_top.v", "line": 23 } },
    "PERIOD_Q": { "width": 8, "flow": "data",    "driver": "PERIOD_FF:Q", "sinks": ["u_pulse:PERIOD"], "meaning": "the period the wave now runs at", "origin": { "file": "seq/pwm_top.v", "line": 25 } },
    "DUTY_Q":   { "width": 8, "flow": "data",    "driver": "DUTY_FF:Q", "sinks": ["u_pulse:DUTY"], "meaning": "the ON cycles the wave now runs at", "origin": { "file": "seq/pwm_top.v", "line": 26 } },
    "PWM":      { "width": 1, "flow": "data",    "driver": "u_pulse:PWM", "sinks": ["@PWM"], "origin": { "file": "seq/pwm_top.v", "line": 15 } },
    "RDY":      { "width": 1, "flow": "control", "driver": "u_rdy:RDY", "sinks": ["@RDY"], "meaning": "active-low: 0 while the core is activated", "origin": { "file": "seq/pwm_top.v", "line": 16 } }
