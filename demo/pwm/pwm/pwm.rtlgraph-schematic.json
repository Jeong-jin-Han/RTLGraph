    "RST":      { "width": 1, "flow": "reset",   "driver": "@RST",    "sinks": ["control_path:RST", "u_pulse:RST", "u_rdy:RST", "STATE_FF:RST", "PERIOD_FF:RST", "DUTY_FF:RST"], "meaning": "1=stop the wave and forget PERIOD and DUTY", "origin": { "file": "seq/pwm_top.v", "line": 10 } },
    "PERIOD":   { "width": 8, "flow": "data",    "driver": "@PERIOD", "sinks": ["PERIOD_FF:D"], "origin": { "file": "seq/pwm_top.v", "line": 11 } },
