    "control_path": {
      "kind": "control", "flow": "control", "time": "comb", "module": "pwm_fsm",
      "label": "FSM code",
      "spec": { "quote": "A state machine keeps the core in IDLE until it is set up,", "page": 1 },
      "ports": { "RST": "in", "SET": "in", "STOP": "in", "STATE": "in", "STATE_D": "out", "LOAD_EN": "out", "RUN_EN": "out", "STOPPED": "out" },
      "truthTable": {
        "inputs": ["RST", "SET", "STOP", "STATE"],
        "outputs": ["STATE_D", "LOAD_EN", "RUN_EN", "STOPPED"],
        "rows": [
          { "in": ["1", "x", "x", "xx"], "out": ["00", "0", "0", "1"], "note": "reset: idle" },
          { "in": ["0", "x", "x", "01"], "out": ["10", "1", "0", "0"], "note": "LOAD: take PERIOD and DUTY, then run" },
          { "in": ["0", "x", "1", "10"], "out": ["00", "0", "0", "1"], "note": "RUN: STOP asked, back to idle" },
          { "in": ["0", "x", "x", "10"], "out": ["10", "0", "1", "0"], "note": "RUN: keep driving" },
          { "in": ["0", "1", "x", "00"], "out": ["01", "0", "0", "1"], "note": "IDLE: SET asked, go and load" },
          { "in": ["0", "0", "x", "00"], "out": ["00", "0", "0", "1"], "note": "IDLE: nothing asked" }
        ],
        "default": { "out": ["00", "0", "0", "1"], "note": "an unused state falls back to idle" },
        "origin": { "file": "comb/control_path/pwm_fsm.v", "line": 28 }
      },
      "origin": { "file": "seq/pwm_top.v", "line": 29 }
    },
    "u_pulse": {
