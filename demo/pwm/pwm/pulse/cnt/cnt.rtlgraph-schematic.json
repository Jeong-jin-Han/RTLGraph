      "label": "CNT",
      "ports": { "CLK": "in", "RST": "in", "EN": "in", "D": "in", "Q": "out" },
      "rstKind": "sync", "rstPriority": "rst>en", "rstValue": "0", "rstActive": "high", "enActive": "high",
      "origin": { "file": "seq/cnt_top.v", "line": 40 }
    }
  }
