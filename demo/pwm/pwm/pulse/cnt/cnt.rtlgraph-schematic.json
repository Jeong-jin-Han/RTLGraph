      "ports": { "a": "in", "b": "in", "y": "out" },
      "consts": { "b": "8'd1" },
      "origin": { "file": "comb/data_path/cnt_dp.v", "line": 18 }
    },
    "data_path.u_mux": {
      "kind": "mux", "flow": "data", "time": "comb", "module": "MUX2", "params": { "BW": 7 },
      "ports": { "sel": "in", "d0": "in", "d1": "in", "y": "out" },
      "origin": { "file": "comb/data_path/cnt_dp.v", "line": 24 }
    },
    "data_path.u_zero": {
      "kind": "op", "flow": "data", "time": "comb", "module": "CMP_EQ", "params": { "BW": 7 },
      "ports": { "a": "in", "b": "in", "y": "out" },
      "consts": { "b": "8'd0" },
      "origin": { "file": "comb/data_path/cnt_dp.v", "line": 31 }
    },
    "control_path": {
      "kind": "control", "flow": "control", "time": "comb", "module": "cnt_cp",
      "ports": { "LOAD": "in", "DEC": "in", "CNT_EN": "out", "CNT_SEL": "out" },
      "truthTable": {
        "inputs": ["LOAD", "DEC"],
        "outputs": ["CNT_EN", "CNT_SEL"],
        "rows": [
          { "in": ["1", "x"], "out": ["1", "1"], "note": "load: take the new phase length" },
          { "in": ["0", "1"], "out": ["1", "0"], "note": "count: take the value one below" },
          { "in": ["0", "0"], "out": ["0", "0"], "note": "hold" }
        ],
        "default": { "out": ["0", "0"] },
        "origin": { "file": "comb/control_path/cnt_cp.v", "line": 19 }
      },
      "origin": { "file": "seq/cnt_top.v", "line": 32 }
    },
    "CNT_FF": {
