    "@LOAD_VAL": { "kind": "port", "dir": "in",  "flow": "data",    "origin": { "file": "seq/cnt_top.v", "line": 13 } },
    "@VAL":      { "kind": "port", "dir": "out", "flow": "data",    "origin": { "file": "seq/cnt_top.v", "line": 14 } },
    "@ZERO":     { "kind": "port", "dir": "out", "flow": "control", "origin": { "file": "seq/cnt_top.v", "line": 15 } },
