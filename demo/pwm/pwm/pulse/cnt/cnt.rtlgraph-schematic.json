  "signals": {
    "CLK":      { "width": 1, "flow": "clock",   "driver": "@CLK", "sinks": ["CNT_FF:CLK"], "hidden": true, "origin": { "file": "seq/cnt_top.v", "line": 9 } },
    "RST":      { "width": 1, "flow": "reset",   "driver": "@RST", "sinks": ["CNT_FF:RST"], "meaning": "1=clear the counter, which also raises ZERO", "origin": { "file": "seq/cnt_top.v", "line": 10 } },
    "LOAD":     { "width": 1, "flow": "control", "driver": "@LOAD", "sinks": ["control_path:LOAD"], "meaning": "1=take LOAD_VAL", "origin": { "file": "seq/cnt_top.v", "line": 11 } },
    "DEC":      { "width": 1, "flow": "control", "driver": "@DEC", "sinks": ["control_path:DEC"], "meaning": "1=count one down", "origin": { "file": "seq/cnt_top.v", "line": 12 } },
    "LOAD_VAL": { "width": 8, "flow": "data",    "driver": "@LOAD_VAL", "sinks": ["data_path.u_mux:d1"], "origin": { "file": "seq/cnt_top.v", "line": 13 } },
    "DOWN":     { "width": 8, "flow": "data",    "driver": "data_path.u_sub:y", "sinks": ["data_path.u_mux:d0"], "meaning": "the value one below the current one", "origin": { "file": "comb/data_path/cnt_dp.v", "line": 16 } },
    "CNT_D":    { "width": 8, "flow": "data",    "driver": "data_path.u_mux:y", "sinks": ["CNT_FF:D"], "origin": { "file": "seq/cnt_top.v", "line": 18 } },
    "VAL":      { "width": 8, "flow": "data",    "driver": "CNT_FF:Q", "sinks": ["data_path.u_sub:a", "data_path.u_zero:a", "@VAL"], "meaning": "the cycles left in the phase now running", "origin": { "file": "seq/cnt_top.v", "line": 14 } },
    "ZERO":     { "width": 1, "flow": "control", "driver": "data_path.u_zero:y", "sinks": ["@ZERO"], "meaning": "1=the counter has run out", "origin": { "file": "seq/cnt_top.v", "line": 15 } },
    "CNT_EN":   { "width": 1, "flow": "control", "driver": "control_path:CNT_EN", "sinks": ["CNT_FF:EN"], "meaning": "1=the counter register takes a new value", "origin": { "file": "seq/cnt_top.v", "line": 19 } },
    "CNT_SEL":  { "width": 1, "flow": "control", "driver": "control_path:CNT_SEL", "sinks": ["data_path.u_mux:sel"], "meaning": "1=take LOAD_VAL, 0=take the value one below", "origin": { "file": "seq/cnt_top.v", "line": 20 } }
  },
  "nodes": {
    "@CLK":      { "kind": "port", "dir": "in",  "flow": "clock",   "origin": { "file": "seq/cnt_top.v", "line": 9 } },
