tmp/
node_modules/
dist/
*.vsix
# ...except the ones that were released: those are kept, the way NodeGraph keeps
# its own, so an older build can be installed again.
!releases/*.vsix
.vscode-test/
.out-*/

# A real handed-out assignment, kept out of the repository: the handout is
# course material. It sits in demo/ so it can be opened like any other demo.
demo/uart-p01/
# The same, for the lab this was driven through to find the limits in the
# 0.2.0 notes: a Vivado project, a synthesized netlist, and a C file as the
# answer. Course material, and 400MB of it.
demo/d04-soc/
# A clean copy of the UART assignment, for trying the prompts the way a new
# user meets them: nothing in it but the code, the handout and the bench.
demo/uart-fresh/

# Copied from the repository root at package time so the marketplace page is the
# same document as GitHub's, with its links rewritten to absolute ones.
packages/vscode-ext/README.md
packages/vscode-ext/LICENSE
packages/vscode-ext/CHANGELOG.md

# What "Copy Agent Spec to Workspace" writes. It is generated, and a copy of it
# inside a demo project would go stale the moment the real files change.
demo/*/.agent/
demo/*/.prompt/
demo/*/.base/

# What a run leaves in a demo project: the waveform reports and the scratch
# the compiler needs. Both are regenerated by `.agent/rtlgraph/run-tb.sh --wave`.
demo/*/waveform/
demo/*/.rtlgraph-build/
